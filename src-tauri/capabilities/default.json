{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capabilities for the main editor window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-read-dir",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" },
        { "path": "$DOCUMENT/*" },
        { "path": "$PICTURE/*" },
        { "path": "$DESKTOP/*" },
        { "path": "$DOWNLOAD/*" }
      ]
    }
  ]
}
